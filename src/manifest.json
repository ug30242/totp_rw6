{
  "package": "com.vela.rw6totp",
  "name": "TOTP",
  "icon": "/common/icon.png",
  "versionName": "1.2.0",
  "versionCode": 6,
  "minAPILevel": 2,
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.storage"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.interconnect"
    }
  ],
  "config": {
    "logLevel": "error",
    "designWidth": 432
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index",
        "path": "/index",
        "launchMode": "singleTask"
      },
      "pages/manual": {
        "component": "index"
      },
      "pages/receive": {
        "component": "index",
        "path": "/receive"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}
