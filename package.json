{
  "name": "com.vela.rw6totp",
  "version": "1.1.0",
  "description": "Redmi Watch 6 offline TOTP authenticator with on-watch entry and a local QR helper",
  "scripts": {
    "start": "aiot start",
    "build": "aiot build",
    "release": "aiot release",
    "test": "node --test tests/*.test.*",
    "verify:rpk": "node scripts/verify-rpk.cjs",
    "web:build": "node scripts/build-web.cjs",
    "check": "npm test && npm run web:build && npm run build",
    "test:web": "npm run web:build && node --test e2e/*.test.cjs",
    "smoke:rpk": "node scripts/smoke-rpk.cjs"
  },
  "devDependencies": {
    "aiot-toolkit": "2.0.5",
    "jsqr": "1.4.0",
    "jszip": "3.10.1",
    "playwright-core": "1.64.1",
    "qrcode": "1.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
