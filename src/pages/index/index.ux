  flex: 1;
  flex-direction: column;
}
.card {
  flex-direction: column;
  background-color: #111827;
  border-radius: 24px;
  padding: 16px 20px;
  margin-bottom: 12px;
}
.card-top {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.acc-name {
  font-size: 24px;
  font-weight: bold;
  color: #cbd5e1;
  lines: 1;
  text-overflow: ellipsis;
  width: 200px;
}
.acc-meta {
  font-size: 18px;
  width: 136px;
  text-align: right;
  color: #64748b;
}
.code-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 6px;
}
.otp-code {
  font-size: 44px;
  font-weight: bold;
  color: #38bdf8;
}
.rem-ok {
  font-size: 24px;
  font-weight: bold;
  color: #22c55e;
}
.rem-warn {
  font-size: 24px;
  font-weight: bold;
  color: #ef4444;
}
.edit-row {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 12px;
}
.act-btn {
  width: 112px;
  height: 48px;
  background-color: #1e293b;
  color: #e2e8f0;
  font-size: 22px;
  border-radius: 14px;
}
.del-btn {
  background-color: #450a0a;
  color: #fca5a5;
}
.footer {
  flex-direction: row;
  justify-content: space-between;
  height: 68px;
  margin-top: 8px;
}
.btn-add {
  width: 248px;
  height: 64px;
  background-color: #0284c7;
  color: #ffffff;
  font-size: 26px;
  font-weight: bold;
  border-radius: 32px;
}
.btn-edit {
  width: 132px;
  height: 64px;
  background-color: #1e293b;
  color: #cbd5e1;
  font-size: 24px;
  border-radius: 32px;
}
</style>
