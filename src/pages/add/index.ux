<template>
  <div class="page">
    <div class="header">
      <text class="title">Add via QR</text>
      <input class="btn-back" type="button" value="Close" onclick="goBack" />
    </div>

    <div class="qr-wrap">
      <qrcode class="qr-code" value="{{ qrValue }}" style="color: #000000; background-color: #ffffff;"></qrcode>
    </div>

    <div class="info-box">
      <text class="code-line">Scan QR with your phone</text>
      <text class="status-line">{{ statusText }}</text>
    </div>

    <div class="footer">
      <input class="btn-poll" type="button" value="Check" onclick="pollRelayNow" />
      <input class="btn-new" type="button" value="New QR" onclick="initSession" />
    </div>
  </div>
</template>

<script>
import router from '@system.router';
import fetch from '@system.fetch';
import vibrator from '@system.vibrator';
import { decryptPayload } from '../../common/totp';
import { appendAccounts } from '../../common/storage';

const IMPORT_URL = 'https://ug30242.github.io/totp_rw6/';
const RELAY_BASE_URL = 'https://ntfy.sh';
const SESSION_MS = 5 * 60 * 1000;

export default {
  private: {
    sessionId: '', sessionKey: '', qrValue: '',
    statusText: '', busy: false
  },

  onInit() { this.initSession(); },
  onShow() { this._visible = true; },
  onHide() {
    this._visible = false;
    this._generation++;
    this.busy = false;
    this.clearCloseTimer();
  },
  onDestroy() { this._visible = false; this.clearCloseTimer(); },

  clearCloseTimer() {
    if (this._closeTimer) clearTimeout(this._closeTimer);
    this._closeTimer = null;
  },

  randomChars(len) {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let out = '';
    for (let i = 0; i < len; i++) out += chars[Math.floor(Math.random() * chars.length)];
    return out;
  },

  initSession() {
    if (this._processing) return;
    this.clearCloseTimer();
    this._generation = (this._generation || 0) + 1;
    this._createdAt = Date.now();
    this._consumed = false;
    this.busy = false;
    this.sessionId = 'RW6' + this.randomChars(16);
    this.sessionKey = this.randomChars(20);
    // All pairing data stays in the fragment, outside HTTP request URLs.
    this.qrValue = IMPORT_URL + '#sid=' + this.sessionId + '&key=' + this.sessionKey;
    this.statusText = 'Send, then tap Check (5 min)';
  },

  async processIncomingPacket(rawPacket, generation) {
    if (!this._visible || generation !== this._generation || this._processing || this._consumed) return false;
    if (Date.now() - this._createdAt > SESSION_MS) throw new Error('Session expired. Tap New QR.');
    this._processing = true;
    try {
      const payload = decryptPayload(rawPacket, this.sessionKey);
      if (!payload || payload.sid !== this.sessionId || !Number.isSafeInteger(payload.expiresAt) ||
          payload.expiresAt < Date.now() || payload.expiresAt > this._createdAt + 2 * SESSION_MS) {
        throw new Error('Wrong or expired session.');
      }
      await appendAccounts(payload.accounts);
      this._consumed = true;
      this.statusText = 'Accounts saved (no duplicates)';
      vibrator.vibrate({ mode: 'short' });
      if (this._visible) this._closeTimer = setTimeout(() => {
        if (this._visible && generation === this._generation) router.back();
      }, 800);
      return true;
    } finally { this._processing = false; }
  },

  pollRelayNow() {
    if (this.busy || this._consumed) return;
    if (Date.now() - this._createdAt > SESSION_MS) {
      this.statusText = 'Session expired. Tap New QR.';
      return;
    }
    this.busy = true;
    this.statusText = 'Receiving encrypted data...';
    const generation = this._generation;
    const url = RELAY_BASE_URL + '/rw6_totp_' + this.sessionId + '/json?poll=1&since=' + Math.floor(this._createdAt / 1000);
    const active = () => this._visible && generation === this._generation;
    fetch.fetch({
      url, method: 'GET', responseType: 'text',
      success: async (res) => {
        if (!active()) return;
        try {
          if (!res || res.code < 200 || res.code >= 300) throw new Error('Server error (' + (res && res.code) + ')');
          const body = String(res.data || '').trim();
          if (body.length > 100000) throw new Error('Received data too large.');
          const lines = body ? body.split(String.fromCharCode(10)) : [];
          let lastError = '';
          for (let i = lines.length - 1; i >= 0; i--) {
            try {
              const item = JSON.parse(lines[i]);
              if (item.event === 'message' && item.message && item.message.indexOf('RW6E1:') === 0) {
                if (await this.processIncomingPacket(item.message, generation)) return;
              }
            } catch (e) { lastError = e.message; }
          }
          if (active()) this.statusText = lastError || 'Nothing received yet.';
        } catch (e) { if (active()) this.statusText = e.message; }
        finally { if (active()) this.busy = false; }
      },
      fail: (data, code) => {
        if (active()) { this.busy = false; this.statusText = 'Check connection (' + code + ')'; }
      }
    });
  },

  goBack() { router.back(); }
};
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 432px;
  height: 514px;
  background-color: #000000;
  padding: 16px 20px;
}
.header {
  width: 392px;
  height: 48px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.title {
  font-size: 28px;
  font-weight: bold;
  color: #f8fafc;
}
.btn-back {
  width: 88px;
  height: 44px;
  background-color: #1e293b;
  color: #cbd5e1;
  font-size: 22px;
  border-radius: 22px;
}
.qr-wrap {
  width: 244px;
  height: 244px;
  background-color: #ffffff;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
  margin-top: 8px;
}
.qr-code {
  width: 216px;
  height: 216px;
}
.info-box {
  flex-direction: column;
  align-items: center;
  margin-top: 10px;
}
.code-line {
  font-size: 22px;
  font-weight: bold;
  color: #38bdf8;
}
.status-line {
  font-size: 20px;
  color: #94a3b8;
  margin-top: 4px;
}
.footer {
  width: 392px;
  height: 64px;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 10px;
}
.btn-poll {
  width: 256px;
  height: 60px;
  background-color: #0284c7;
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
  border-radius: 30px;
}
.btn-new {
  width: 124px;
  height: 60px;
  background-color: #1e293b;
  color: #cbd5e1;
  font-size: 22px;
  border-radius: 30px;
}
</style>
