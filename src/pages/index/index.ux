<template>
  <div class="page">
    <div class="header">
      <text class="title">TOTP</text>
      <text class="badge">{{ globalRemaining }}s</text>
    </div>

    <text class="error-text" if="{{ errorText }}">{{ errorText }}</text>

    <div class="empty-box" if="{{ accounts.length === 0 }}">
      <text class="empty-text">No accounts yet.</text>
      <text class="empty-sub">Tap + QR Add to get started.</text>
    </div>

    <list class="account-list" if="{{ accounts.length > 0 }}">
      <list-item type="account-card" class="card" for="{{ (idx, item) in renderedList }}">
        <div class="card-top">
          <text class="acc-name">{{ item.name }}</text>
          <text class="acc-meta">{{ item.algorithm }} / {{ item.digits }} digits</text>
        </div>

        <div class="code-row">
          <text class="otp-code">{{ item.formattedOtp }}</text>
          <text class="{{ item.isExpiring ? 'rem-warn' : 'rem-ok' }}">{{ item.remaining }}s</text>
        </div>

        <div class="edit-row" if="{{ editMode }}">
          <input class="act-btn" type="button" value="Up" onclick="onMoveUp(idx)" />
          <input class="act-btn" type="button" value="Down" onclick="onMoveDown(idx)" />
          <input class="act-btn del-btn" type="button" value="{{ deleteIndex === idx ? 'Confirm' : 'Delete' }}" onclick="onDelete(idx)" />
        </div>
      </list-item>
    </list>

    <div class="footer">
      <input class="btn-add" type="button" value="+ QR Add" onclick="goAddPage" />
      <input class="btn-edit" type="button" value="{{ editMode ? 'Done' : 'Edit' }}" onclick="toggleEdit" />
    </div>
  </div>
</template>

<script>
import router from '@system.router';
import vibrator from '@system.vibrator';
import { generateTOTP } from '../../common/totp';
import { displayAccountName } from '../../common/display-name';
import { loadAccounts, moveAccountOrder, removeAccountAt } from '../../common/storage';

export default {
  private: {
    accounts: [],
    renderedList: [],
    editMode: false,
    globalRemaining: 30,
    timerId: null,
    errorText: '',
    deleteIndex: -1,
    busy: false
  },

  onShow() {
    this.refreshAccounts();
    this.startTicker();
  },

  onHide() {
    this.stopTicker();
    this.deleteIndex = -1;
  },

  onDestroy() {
    this.stopTicker();
  },

  async refreshAccounts() {
    try {
      this.accounts = await loadAccounts();
      this.errorText = '';
      this._otpCache = {};
      this.updateOtps();
    } catch (e) { this.errorText = e.message; }
  },

  startTicker() {
    this.stopTicker();
    this.updateOtps();
    this.timerId = setInterval(() => {
      this.updateOtps();
    }, 1000);
  },

  stopTicker() {
    if (this.timerId !== null) {
      clearInterval(this.timerId);
      this.timerId = null;
    }
  },

  formatOtp(otp) {
    const s = String(otp || '');
    if (s.length === 8) return s.slice(0, 4) + ' ' + s.slice(4);
    return s.slice(0, 3) + ' ' + s.slice(3);
  },

  updateOtps() {
    const timestamp = Date.now();
    const nowSec = Math.floor(timestamp / 1000);
    this.globalRemaining = 30 - (nowSec % 30);

    const list = [];
    for (let i = 0; i < this.accounts.length; i++) {
      const acc = this.accounts[i];
      try {
        if (!this._otpCache) this._otpCache = {};
        const cacheKey = acc.id || String(i);
        const step = Math.floor(nowSec / acc.period);
        let cached = this._otpCache[cacheKey];
        if (!cached || cached.step !== step) {
          cached = {step, result:generateTOTP(acc, timestamp)};
          this._otpCache[cacheKey] = cached;
        }
        const res = cached.result;
        const remaining = res.period - nowSec % res.period;
        list.push({
          id: acc.id,
          name: displayAccountName(acc.name, i),
          algorithm: acc.algorithm || 'SHA1',
          digits: acc.digits || 6,
          formattedOtp: this.formatOtp(res.otp),
          remaining,
          isExpiring: remaining <= 5
        });
      } catch (_) {
        list.push({
          id: acc.id,
          name: displayAccountName(acc.name, i),
          algorithm: acc.algorithm || 'SHA1',
          digits: acc.digits || 6,
          formattedOtp: 'ERR KEY',
          remaining: 0,
          isExpiring: true
        });
      }
    }
    this.renderedList = list;
  },

  toggleEdit() {
    this.editMode = !this.editMode;
    this.deleteIndex = -1;
    vibrator.vibrate({ mode: 'short' });
  },

  async onMoveUp(idx) {
    await this.changeAccounts(Number(idx), -1);
  },

  async onMoveDown(idx) {
    await this.changeAccounts(Number(idx), 1);
  },

  async onDelete(idx) {
    idx = Number(idx);
    if (this.deleteIndex !== idx) { this.deleteIndex = idx; return; }
    await this.changeAccounts(idx, 0);
  },

  async changeAccounts(idx, direction) {
    if (this.busy) return;
    this.busy = true;
    try {
      this.accounts = direction ? await moveAccountOrder(idx, direction) : await removeAccountAt(idx);
      this.deleteIndex = -1;
      this.errorText = '';
      this._otpCache = {};
      this.updateOtps();
      vibrator.vibrate({ mode: 'short' });
    } catch (e) { this.errorText = e.message; }
    finally { this.busy = false; }
  },

  goAddPage() {
    router.push({ uri: 'pages/add' });
  }
};
</script>

